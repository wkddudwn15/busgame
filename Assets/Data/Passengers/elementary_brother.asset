  hotspotAnchorMax: {x: 0.64, y: 0.6}
  memoryLines:
  - "\u304A\u5144\u3061\u3083\u3093\u306E\u7528\u4E8B\u306B\u3064\u3044\u3066\u3044\u304F\u306E\u3001\u3061\u3087\u3063\u3068\u3060\u3051\u697D\u3057\u304B\u3063\u305F\u3002"
  - "\u8ECA\u306E\u4E2D\u3067\u597D\u304D\u306A\u66F2\u3092\u6D41\u3057\u3066\u3082\u3089\u3063\u3066\u3001\u5C0F\u3055\u306A\u58F0\u3067\u6B4C\u3063\u3066\u3044\u305F\u3002"
  - "\u7A93\u306E\u5916\u3092\u898B\u305F\u3089\u3001\u5F8C\u308D\u306B\u767D\u3044\u8ECA\u304C\u3044\u305F\u3002"
  - "\u300C\u3042\u306E\u8ECA\u3001\u30DE\u30DE\u306E\u8ECA\u3068\u540C\u3058\u8272\u3060\u3063\u305F\u306A\u3002\u300D"
  - "\u8ECA\u306E\u540D\u524D\u3068\u304B\u3001\u3069\u308C\u304F\u3089\u3044\u901F\u304B\u3063\u305F\u3068\u304B\u3001\u904B\u8EE2\u3057\u3066\u3044\u305F\u4EBA\u307E\u3067\u306F\u5206\u304B\u3089\u306A\u3044\u3002"
  - "\u304A\u5144\u3061\u3083\u3093\u306F\u30B9\u30DE\u30DB\u3092\u898B\u3066\u3044\u3066\u3001\u307C\u304F\u306E\u65B9\u304C\u5916\u3092\u898B\u3066\u3044\u305F\u3068\u601D\u3046\u3002"
  - "\u5927\u304D\u306A\u97F3\u304C\u3057\u3066\u3001\u4F53\u304C\u304E\u3085\u3063\u3068\u62BC\u3055\u308C\u305F\u3002"
  - "\u300C\u304A\u5144\u3061\u3083\u3093\u306F\u3044\u308B\u3051\u3069\u3001\u30DE\u30DE\u306F\u3069\u3053\u306B\u3044\u308B\u306E\uFF1F\u300D"
  - "\u305D\u3053\u304B\u3089\u5148\u306F\u3001\u601D\u3044\u51FA\u305B\u306A\u3044\u3002"
