  id: elementary_brother
  displayName: "小学生の弟"
  viewDirection: 2
  hotspotAnchorMin: {x: 0.43, y: 0.28}
  hotspotAnchorMax: {x: 0.64, y: 0.6}
  memoryLines:
  - "今日はママとお兄ちゃんと一緒におでかけなんだよ。"
  - "僕の大好きな車に乗って！"
  - "お兄ちゃんが駅に用事があるって言っていたから、ついてきたんだ。"
  - "大好きな曲をかけて、お歌を歌いながら、ドーンって大きな音がしたの！"
  - "あの車、ママの車と同じ色だったな。"
  - "あれ、お兄ちゃんはいるけど、ママはどこにいるの？"
  collectibleWordSpans:
  - lineIndex: 0
    targetText: "ママ"
    occurrenceIndex: 0
    wordData: {fileID: 11400000, guid: 1f1468e73ea3db54db1c43b53f021a9b, type: 2}
